<form action="@Url.Action("SelectOffers", "Graduation")" method="post">
    @Html.AntiForgeryToken()
<h1>Category 1: Graduation Certificates</h1>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Supplier Name</th>
            <th>Offer Name</th>
            <th>Quantity</th>
            <th>Unit Price</th>
                <th>Select</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>Supplier A</td>
            <td>Premium Certificate Package</td>
            <td>35</td>
            <td>2 JD</td>
                <td>
                    <input type="radio" name="certificateOffer" value="A" required />
                </td>
        </tr>

        <tr>
            <td>Supplier B</td>
            <td>Standard Certificate Package</td>
            <td>35</td>
            <td>1.5 JD</td>
                <td>
                    <input type="radio" name="certificateOffer" value="B" required />
                </td>
        </tr>

        <tr>
            <td>Supplier C</td>
            <td>Luxury Certificate Package</td>
            <td>35</td>
            <td>2.5 JD</td>
                <td>
                    <input type="radio" name="certificateOffer" value="C" required />
                </td>
        </tr>
    </tbody>
</table>

